# ============================================
# Cross-Market Arbitrage Bot — Environment Variables
# ============================================

# --- Application ---
APP_ENV=development
APP_SECRET_KEY=your-256-bit-secret-key-here
JWT_SECRET=your-jwt-secret
ENCRYPTION_MASTER_KEY=your-master-encryption-key-base64

# --- Database ---
DATABASE_URL=postgresql+asyncpg://arbitrage_user:password@localhost:5432/arbitrage_bot
REDIS_URL=redis://localhost:6379/0

# --- Forex Broker Connections ---
MT5_LOGIN=your-mt5-account-number
MT5_PASSWORD=your-mt5-password
MT5_SERVER=your-mt5-broker-server
OANDA_API_KEY=your-oanda-api-key
OANDA_ACCOUNT_ID=your-oanda-account-id
OANDA_ENVIRONMENT=practice

# --- Polymarket (Polygon) ---
POLYMARKET_API_KEY=your-polymarket-api-key
POLYMARKET_API_SECRET=your-polymarket-api-secret
POLYMARKET_PASSPHRASE=your-polymarket-passphrase
POLYGON_RPC_URL=https://polygon-rpc.com
POLYGON_PRIVATE_KEY=your-polygon-wallet-private-key

# --- Premu (Arbitrum) ---
ARBITRUM_RPC_URL=https://arb1.arbitrum.io/rpc
ARBITRUM_PRIVATE_KEY=your-arbitrum-wallet-private-key
PREMU_VAULT_ADDRESS=0x...

# --- Monaco Protocol (Solana) ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=your-solana-private-key-base58

# --- Macro Event Feeds ---
WEBHOOK_SECRET=your-webhook-hmac-secret
TRADINGVIEW_WEBHOOK_URL=auto-generated
BLOOMBERG_API_KEY=your-bloomberg-api-key

# --- Risk Parameters ---
MAX_POSITION_SIZE_USD=1000
LATENCY_ARB_MIN_GAP_PCT=1.5
NEG_RISK_THRESHOLD=0.96
KILL_SWITCH_ENABLED=false

# --- Admin Panel ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
